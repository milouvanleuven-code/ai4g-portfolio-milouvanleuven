    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Alleen afspraken met een echte start- en eindtijd.\n// All-day events worden hierdoor niet meegenomen.\nconst events = items\n  .map(item => item.json)\n  .filter(event =>\n    event.status !== 'cancelled' &&\n    event.start?.dateTime &&\n    event.end?.dateTime\n  );\n\nlet scheduledMinutes = 0;\nlet firstStart = null;\nlet lastEnd = null;\n\nfor (const event of events) {\n  const start = new Date(event.start.dateTime);\n  const end = new Date(event.end.dateTime);\n\n  scheduledMinutes += (end - start) / 60000;\n\n  if (!firstStart || start < firstStart) firstStart = start;\n  if (!lastEnd || end > lastEnd) lastEnd = end;\n}\n\nconst eventCount = events.length;\nconst scheduledHours = scheduledMinutes / 60;\n\n// Workload-score\nlet loadScore = 0;\n\nif (scheduledMinutes > 300) loadScore += 1;\nif (scheduledMinutes > 420) loadScore += 1;\nif (eventCount >= 5) loadScore += 1;\n\nif (firstStart) {\n  const firstHour = firstStart.getHours() + firstStart.getMinutes() / 60;\n  if (firstHour < 9) loadScore += 1;\n}\n\nif (lastEnd) {\n  const lastHour = lastEnd.getHours() + lastEnd.getMinutes() / 60;\n  if (lastHour > 18) loadScore += 1;\n}\n\nlet todayLoad = 'Light';\n\nif (loadScore >= 4) {\n  todayLoad = 'Busy';\n} else if (loadScore >= 2) {\n  todayLoad = 'Moderate';\n}\n\nreturn [{\n  json: {\n    eventCount,\n    scheduledMinutes: Math.round(scheduledMinutes),\n    scheduledHours: Math.round(scheduledHours * 10) / 10,\n    firstEvent: firstStart ? firstStart.toISOString() : null,\n    lastEvent: lastEnd ? lastEnd.toISOString() : null,\n    todayLoadScore: loadScore,\n    todayLoad\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
